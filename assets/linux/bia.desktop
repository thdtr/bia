[Desktop Entry]
Type=Application
Name=BIA
GenericName=Code Editor
GenericName[pt_BR]=Editor de Código
Comment=A happy minimalist editor
Comment[pt_BR]=Um editor minimalista feliz
Exec=bia %F
Terminal=false
Categories=Development;TextEditor;Utility;
Keywords=editor;code;text;rust;
MimeType=text/plain;inode/directory;
Icon=bia
StartupWMClass=bia
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Name[pt_BR]=Nova janela
Exec=bia --new
